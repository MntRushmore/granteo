# Slack Configuration
# Get these from https://api.slack.com/apps
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Slack Channel IDs
# The channel where grant logs and bot status updates will be posted
LOGS_CHANNEL_ID=C0123456789

# Database
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/granteo?schema=public

# Server Configuration
# Port for the bot to run on (optional, defaults to 3030)
PORT=3030

# Environment
# Set to 'development' for development mode with verbose logging
NODE_ENV=production
